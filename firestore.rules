rules_version = '2';

// Reglas del CRM para un equipo pequeño compartido.
// - Solo miembros activos (members/{uid}.active == true) leen y escriben datos.
// - Contactos y catálogo: visibles para todo el equipo.
// - Leads, su historial y sus follow-ups: un vendedor solo ve y toca los suyos (assigneeId);
//   un admin ve todo y es el único que reasigna.
// - El primer usuario crea meta/team y queda como admin.
// - Los demás entran si un admin creó invites/{email}.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function memberPath(uid) {
      return /databases/$(database)/documents/members/$(uid);
    }
    function isMember() {
      return signedIn()
        && exists(memberPath(request.auth.uid))
        && get(memberPath(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isMember() && get(memberPath(request.auth.uid)).data.role == 'admin';
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function invitePath() {
      return /databases/$(database)/documents/invites/$(myEmail());
    }
    function teamPath() {
      return /databases/$(database)/documents/meta/team;
    }
    function isString(v, max) {
      return v is string && v.size() <= max;
    }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function isMine(d) {
      return d.assigneeId == request.auth.uid;
    }
    function leadPath(leadId) {
      return /databases/$(database)/documents/leads/$(leadId);
    }
    // El lead es visible para quien pide: admin o su responsable.
    function canSeeLead(leadId) {
      return isAdmin() || get(leadPath(leadId)).data.assigneeId == request.auth.uid;
    }
    // Igual, pero mirando el estado tras el batch (lead creado o reasignado en el mismo lote).
    function canSeeLeadAfter(leadId) {
      return isAdmin() || getAfter(leadPath(leadId)).data.assigneeId == request.auth.uid;
    }

    // ---- Equipo ----
    match /meta/team {
      allow read: if signedIn();
      // Solo el primero: crea el equipo junto con su ficha de admin (en el mismo batch).
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'name', 'createdAt'])
        && getAfter(memberPath(request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin() && changedOnly(['name']);
      allow delete: if false;
    }

    match /members/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.active == true
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'role', 'active', 'createdAt'])
        && (
          // Fundador: no existe equipo y lo crea en el mismo batch.
          (request.resource.data.role == 'admin'
            && !exists(teamPath())
            && getAfter(teamPath()).data.ownerUid == uid)
          ||
          // Invitado: el rol debe coincidir con la invitación.
          (exists(invitePath())
            && request.resource.data.role == get(invitePath()).data.role)
        );

      // Admins cambian rol/acceso de otros; cada uno puede actualizar su nombre y foto.
      // Nadie cambia su propio rol ni acceso: quien quita un admin sigue siéndolo,
      // así el equipo nunca se queda sin un admin activo.
      allow update: if (isAdmin() && uid != request.auth.uid && changedOnly(['role', 'active'])
                        && request.resource.data.role in ['admin', 'member']
                        && request.resource.data.active is bool)
                    || (isMember() && uid == request.auth.uid && changedOnly(['displayName', 'photoURL']));
      allow delete: if false;
    }

    match /invites/{email} {
      allow read: if isAdmin() || (signedIn() && myEmail() == email);
      allow create: if isAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.role in ['admin', 'member']
        && request.resource.data.invitedBy == request.auth.uid;
      // El invitado la consume al entrar; un admin la puede retirar.
      allow delete: if isAdmin() || (signedIn() && myEmail() == email);
      // Un admin puede cambiar el rol de una invitación aún no usada.
      allow update: if isAdmin()
        && changedOnly(['role'])
        && request.resource.data.role in ['admin', 'member'];
    }

    // ---- Catálogo de servicios y categorías de venta (solo admin escribe) ----
    function pricingPath() {
      return /databases/$(database)/documents/meta/pricing;
    }
    function servicePath(id) {
      return /databases/$(database)/documents/services/$(id);
    }
    function validRate(v) {
      return v is number && v >= 0 && v <= 100;
    }
    // Porcentaje vigente de una categoría (valores por defecto si aún no hay meta/pricing).
    function tierRate(tier) {
      return exists(pricingPath())
        ? get(pricingPath()).data.get(tier, tier == 'bronze' ? 3 : tier == 'silver' ? 5 : 7)
        : (tier == 'bronze' ? 3 : tier == 'silver' ? 5 : 7);
    }

    match /meta/pricing {
      allow read: if isMember();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['bronze', 'silver', 'gold', 'updatedAt'])
        && validRate(request.resource.data.bronze)
        && validRate(request.resource.data.silver)
        && validRate(request.resource.data.gold);
    }

    function validService(d) {
      return isString(d.name, 200) && d.name.size() > 0
        && isString(d.description, 1000)
        && d.price is number && d.price >= 0
        && isString(d.unit, 50)
        && d.active is bool;
    }

    match /services/{serviceId} {
      allow read: if isMember();
      allow create: if isAdmin() && validService(request.resource.data);
      allow update: if isAdmin() && validService(request.resource.data);
      // Nunca se borran: se archivan para conservar el historial de lo vendido.
      allow delete: if false;
    }

    // ---- Contactos (prospectos y clientes) ----
    function validContact(d) {
      return isString(d.name, 200) && d.name.size() > 0
        && isString(d.company, 200)
        && isString(d.email, 200)
        && isString(d.phone, 50)
        && isString(d.notes, 5000)
        && d.assigneeId is string;
    }

    match /contacts/{contactId} {
      allow read: if isMember();
      allow create: if isMember()
        && validContact(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      // El resumen de compras (wonCount, wonTotal, firstWonAt, openBy) lo mantiene la app
      // en el mismo batch que el lead. El responsable del contacto solo lo cambia un admin.
      allow update: if isMember()
        && validContact(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && (isAdmin() || request.resource.data.assigneeId == resource.data.assigneeId);
      allow delete: if isAdmin();
    }

    // ---- Leads (oportunidades) ----
    function validLead(d) {
      return isString(d.name, 200) && d.name.size() > 0
        && isString(d.company, 200)
        && isString(d.email, 200)
        && isString(d.phone, 50)
        && isString(d.notes, 5000)
        && isString(d.get('detail', ''), 1000)
        && d.stage in ['new', 'contacted', 'qualified', 'proposal', 'negotiation', 'won', 'lost']
        && d.source in ['web', 'whatsapp', 'phone', 'referral', 'social', 'event', 'email', 'other']
        && d.value is number && d.value >= 0
        && d.assigneeId is string
        && (d.get('contactId', null) == null
            || existsAfter(/databases/$(database)/documents/contacts/$(d.contactId)));
    }

    // Lead con servicio: el valor sale del precio oficial × cantidad + % de la categoría.
    function hasService(d) {
      return d.get('serviceId', null) != null;
    }
    function priceMath(d) {
      return d.quantity is number && d.quantity > 0
        && d.unitPrice is number && d.unitPrice >= 0
        && d.tier in ['bronze', 'silver', 'gold']
        && d.tierPct is number
        && math.abs(d.value - d.unitPrice * d.quantity * (100 + d.tierPct) / 100) < 0.011;
    }
    // Al crear: precio y porcentaje deben ser los vigentes.
    function pricingOnCreate(d) {
      return !hasService(d)
        ? d.value == 0
        : priceMath(d)
          && get(servicePath(d.serviceId)).data.price == d.unitPrice
          && d.tierPct == tierRate(d.tier);
    }
    function pricingKeys() {
      return ['serviceId', 'serviceName', 'quantity', 'unitPrice', 'tier', 'tierPct', 'value'];
    }
    // Al editar: un lead ganado no cambia de precio; uno abierto solo puede tomar el precio
    // oficial vigente (o conservar el pactado) y el porcentaje vigente (o conservar el suyo).
    // Sin servicio, el valor no se toca a mano: hay que elegir un servicio del catálogo.
    function pricingOnUpdate(d, old) {
      return !d.diff(old).affectedKeys().hasAny(pricingKeys())
        || (old.stage != 'won'
            && (!hasService(d)
                ? !hasService(old) && d.value == old.value
                : priceMath(d)
                  && (d.unitPrice == old.get('unitPrice', -1) && d.serviceId == old.get('serviceId', null)
                      || get(servicePath(d.serviceId)).data.price == d.unitPrice)
                  && (d.tierPct == old.get('tierPct', -1) && d.tier == old.get('tier', null)
                      || d.tierPct == tierRate(d.tier))));
    }

    match /leads/{leadId} {
      // Las consultas de un vendedor deben filtrar por assigneeId == su uid.
      allow read: if isAdmin() || (isMember() && isMine(resource.data));
      // Un vendedor solo crea leads a su nombre.
      allow create: if isMember()
        && (isAdmin() || isMine(request.resource.data))
        && validLead(request.resource.data)
        && pricingOnCreate(request.resource.data)
        && request.resource.data.createdBy == request.auth.uid;
      // Solo un admin cambia el responsable (reasignar).
      allow update: if isMember()
        && (isAdmin() || (isMine(resource.data) && isMine(request.resource.data)))
        && validLead(request.resource.data)
        && pricingOnUpdate(request.resource.data, resource.data)
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin()
        || (isMember() && isMine(resource.data) && resource.data.createdBy == request.auth.uid);

      match /activities/{activityId} {
        // Si el lead aún no existe en el servidor (la app ya lo muestra mientras se guarda),
        // no hay nada que proteger: la consulta devuelve vacío en vez de fallar.
        allow read: if isMember() && (!exists(leadPath(leadId)) || canSeeLead(leadId));
        allow create: if isMember()
          && canSeeLeadAfter(leadId)
          && request.resource.data.createdBy == request.auth.uid
          && isString(request.resource.data.body, 5000);
        allow update: if isMember() && canSeeLead(leadId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy;
        // Borrado: el autor, o quien borra el lead completo (admin o creador del lead).
        allow delete: if isMember() && canSeeLead(leadId) && (
          resource.data.createdBy == request.auth.uid
          || isAdmin()
          || get(leadPath(leadId)).data.createdBy == request.auth.uid
        );
      }
    }

    match /followups/{followUpId} {
      // Las consultas de un vendedor deben filtrar por assigneeId == su uid.
      allow read: if isAdmin() || (isMember() && isMine(resource.data));
      // El follow-up es del responsable del lead.
      allow create: if isMember()
        && canSeeLeadAfter(request.resource.data.leadId)
        && request.resource.data.assigneeId == getAfter(leadPath(request.resource.data.leadId)).data.assigneeId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.dueAt is timestamp
        && request.resource.data.channel in ['call', 'whatsapp', 'email', 'meeting', 'task']
        && isString(request.resource.data.note, 1000);
      allow update: if isMember()
        && (isAdmin() || (isMine(resource.data) && isMine(request.resource.data)))
        && request.resource.data.status in ['pending', 'done', 'cancelled']
        && request.resource.data.leadId == resource.data.leadId
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin() || (isMember() && isMine(resource.data));
    }
  }
}
