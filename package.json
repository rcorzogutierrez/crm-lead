{
  "name": "crm-lead",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:emulator": "ng serve -c emulator",
    "emulators": "npx -y firebase-tools@latest emulators:start --only auth,firestore --project demo-crm-lead",
    "deploy:rules": "npx -y firebase-tools@latest deploy --only firestore",
    "deploy": "ng build && npx -y firebase-tools@latest deploy"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@lucide/angular": "^1.61.0",
    "firebase": "^13.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}